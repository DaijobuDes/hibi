    <Synset id="oewn-01152997-a" ili="i6288" members="oewn-unhappy-a" partOfSpeech="a" lexfile="adj.all">
      <Definition>experiencing or marked by or causing sadness or sorrow or discontent</Definition>
      <Example>unhappy over her departure</Example>
      <Example>unhappy with her raise</Example>
      <Example>after the argument they lapsed into an unhappy silence</Example>
      <Example>had an unhappy time at school</Example>
      <Example>the unhappy (or sad) news</Example>
      <Example>he looks so unhappy</Example>
    </Synset>
    <Synset id="oewn-01839438-v" ili="i30898" members="oewn-travel-v oewn-go-v oewn-move-v oewn-locomote-v" partOfSpeech="v" lexfile="verb.motion">
