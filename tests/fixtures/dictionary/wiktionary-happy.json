    },
    {
      "partOfSpeech": "Verb",
      "language": "English",
      "definitions": [
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt563\" typeof=\"mw:Transclusion\"></span> <i>Often followed by</i> <b><span class=\"Latn\" lang=\"en\" about=\"#mwt564\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/up#English\" title=\"up\">up</a></span></b>: to <a rel=\"mw:WikiLink\" href=\"/wiki/become\" title=\"become\">become</a> happy; to <a rel=\"mw:WikiLink\" href=\"/wiki/brighten_up\" title=\"brighten up\">brighten up</a>, to <a rel=\"mw:WikiLink\" href=\"/wiki/cheer_up\" title=\"cheer up\">cheer up</a>."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt568\" typeof=\"mw:Transclusion\"></span> <i>Often followed by</i> <b><span class=\"Latn\" lang=\"en\" about=\"#mwt569\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/up#English\" title=\"up\">up</a></span></b>: to <a rel=\"mw:WikiLink\" href=\"/wiki/make\" title=\"make\">make</a> happy; to <a rel=\"mw:WikiLink\" href=\"/wiki/brighten\" title=\"brighten\">brighten</a>, to <a rel=\"mw:WikiLink\" href=\"/wiki/cheer#Verb\" title=\"cheer\">cheer</a>, to <a rel=\"mw:WikiLink\" href=\"/wiki/enliven\" title=\"enliven\">enliven</a>."
