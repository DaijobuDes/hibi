{
  "name": "hibi",
  "version": "0.1.0",
  "description": "hibi desktop",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run typecheck && electron-vite build && npm run build:site",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "check": "npm run lint && npm run docs:check && npm test",
    "package": "npm run build && electron-builder --dir -c.mac.identity=-",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.15",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "geist": "1.7.2",
    "lucide-react": "1.46.0",
    "marked": "18.0.13",
    "minisearch": "7.2.0",
    "playwright": "1.63.0",
    "prosemirror-search": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.31.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "yaml": "2.9.1"
  }
}
